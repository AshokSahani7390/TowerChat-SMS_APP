# ==============================================================================
# TOWERCHAT WEB RUNNER & API BRIDGE ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure secrets locally. Never commit .env to Git.
# ==============================================================================

# Server Environment Mode ('production', 'development', or 'test')
NODE_ENV=development

# Web Runner Port
PORT=3000

# Path to Android SDK Platform Tools (adb executable)
# Windows Example: C:\\Users\\<Username>\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe
# Linux/macOS Example: /home/<username>/Android/Sdk/platform-tools/adb
ADB_PATH=C:\\Users\\Ashok\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe

# Comma-separated list of trusted upstream reverse proxy IPs (e.g. Nginx, Cloudflare, 127.0.0.1)
# Used to safely inspect X-Forwarded-For headers without spoofing risk
TRUSTED_PROXIES=127.0.0.1

# Optional test secret for resetting rate limits during automated integration runs
# In production, set to a strong random token or leave unset to completely disable the hook
TEST_SECRET=change_me_to_a_secure_random_token_for_testing
