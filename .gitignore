# ==============================================================================
# TOWERCHAT SECRETS & BUILD ARTIFACT EXCLUSIONS (.gitignore)
# ==============================================================================

# Android & Gradle Build Artifacts
.gradle/
build/
app/build/
*.apk
*.aab
*.ap_
output.json

# Local Configuration & Machine-Specific Files (Contains usernames & paths)
local.properties
.kotlin/
*.log

# Keystores, Signing Keys, Certificates (CRITICAL: Never commit to Git)
*.jks
*.keystore
*.p12
*.pem
*.key
*.pkcs12

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Google Services / Firebase Credentials
google-services.json
firebase.json

# IDE & Editor Specific Files
.idea/
.vscode/
*.iml
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS-Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Node.js Dependencies & Cache (web-runner)
web-runner/node_modules/
web-runner/temp_uploads/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
